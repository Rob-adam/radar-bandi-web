{
  "name": "radar-bandi-online",
  "main": "./src/dashboard-wrapper.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "LICENSES",
      "id": "352020f5c8294218ac658bfb3e96161c"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "placement": {
    "region": "aws:eu-south-1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ONBOARDING",
        "class_name": "OnboardingRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "onboarding-v1",
      "new_sqlite_classes": [
        "OnboardingRegistry"
      ]
    }
  ],
  "vars": {
    "ONBOARDING_ENABLED": "false",
    "SMTP_HOST": "authsmtp.securemail.pro",
    "SMTP_PORT": "465",
    "SMTP_FROM": "info@bandovera.it",
    "SMTP_VERIFIED": "false",
    "BONIFICO_VERIFIED": "false"
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  }
}
