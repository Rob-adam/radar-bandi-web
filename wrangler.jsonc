{
  "name": "radar-bandi-online",
  "main": "./src/dashboard-wrapper.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "LICENSES",
      "id": "352020f5c8294218ac658bfb3e96161c"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "placement": {
    "region": "aws:eu-south-1"
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTACTS",
        "class_name": "ContactDispatcher"
      },
      {
        "name": "LIVE_COORDINATOR",
        "class_name": "StripeLiveCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "contacts-v1",
      "new_sqlite_classes": [
        "ContactDispatcher"
      ]
    },
    {
      "tag": "stripe-live-v1",
      "new_sqlite_classes": ["StripeLiveCoordinator"]
    }
  ],
  "vars": {
    "BANDOVERA_ENV": "production",
    "LIVE_FULFILLMENT_ENABLED": "false",
    "LIVE_CHECKOUT_ENABLED": "false",
    "LIVE_LICENSES_ID": "352020f5c8294218ac658bfb3e96161c",
    "STRIPE_LIVE_PRICE_ID": "price_1UWHRjDY6SOGDjJ1Exlw0SHk",
    "CONTACTS_ENABLED": "true",
    "SMTP_VERIFIED": "true",
    "SMTP_HOST": "authsmtp.securemail.pro",
    "SMTP_PORT": "465",
    "SMTP_FROM": "info@bandovera.it"
  }
}
